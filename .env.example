# Anthropic -- the only thing you actually need to fill in to run the app.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Optional -- the model behind the scope gate (app/intent_router.py) that
# classifies every message before the tool-equipped agent runs. Defaults to
# a small/fast model since classification is a narrow, single-turn call;
# override only if your account doesn't have this exact model available.
# ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001

# Data backend -- defaults to an in-memory mock of Snowflake
# (app/mock_snowflake.py), so the app runs with nothing below filled in.
# Set this to "live" to run against a real Snowflake account instead.
# BOOKLY_DATA_BACKEND=live

# Snowflake -- only read when BOOKLY_DATA_BACKEND=live. See snowflake/*.sql
# for the schema/Cortex Search service/least-privilege setup this expects,
# and README.md's "Data backend" section for the full walkthrough.
# SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
# SNOWFLAKE_USER=BOOKLY_AGENT_SVC
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_WAREHOUSE=BOOKLY_AGENT_WH
# SNOWFLAKE_DATABASE=BOOKLY
# SNOWFLAKE_SCHEMA=SUPPORT
# SNOWFLAKE_ROLE=BOOKLY_AGENT_ROLE

# Optional -- only needed if you named the service in 03_cortex_search.sql
# something other than the default.
# CORTEX_SEARCH_SERVICE=BOOKLY_POLICY_SEARCH
